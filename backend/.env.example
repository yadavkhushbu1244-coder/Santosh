# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_public_key
# The SERVICE_ROLE_KEY is used strictly on the backend for admin/auth verification tasks.
# NEVER expose this key to the frontend or git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_secret_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
